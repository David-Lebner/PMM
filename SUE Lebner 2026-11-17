download.file("https://github.com/georgernstgraf/GRG-PMM/raw/refs/heads/main/assets/betriebsdaten.csv", "betriebsdaten.csv")
daten <- read.csv("betriebsdaten.csv")

install.packages("tidyverse")   # nur einmal nötig, falls noch nicht installiert
library(tidyverse)

#1. Vorhersagen 
# a)Vorhersage: Ungefähr 40 pro Maschine, bei einigen etwas weniger, weil ein paar Werte fehlen (NA). M1 vermutlich am wenigsten, etwa 38.
# b)Vorhersage: M3 hat den größten Abstand, etwa 5 Hundertstel (0,05 mm).


daten |> group_by(maschine) |>
  summarise(n = sum(!is.na(masse_mm)))

daten |> group_by(maschine) |>
  summarise(mittel = mean(masse_mm, na.rm = TRUE),
            abstand_hundertstel = abs(mittel - 10) * 100)

#c) Antwort; M1 gegen M3 fällt leichter durch: Der Mittelwertunterschied (0,062 mm) ist deutlich größer als bei M1 gegen M2 (0,024 mm). Das wiegt die größere Streuung von M3 (0,070 mm) auf, der Unterschied hebt sich also klarer vom Rauschen ab.
#b) Bestätigung von meiner Vorhersage;M3 hat mit 6,27 Hundertstel den größten Abstand zum Sollmaß (M2: 2,31, M1: 0,05).

#2. Der ungepaarte Vergleich
#H0: Die wahren Mittelwerte von M1 und M3 sind gleich (μ₁ = μ₃, Differenz = 0).
#H1: Die wahren Mittelwerte von M1 und M3 sind verschieden (μ₁ ≠ μ₃, Differenz ≠ 0). Der Test ist zweiseitig.

vergleich <- daten |> filter(maschine %in% c("M1", "M3"))
t.test(masse_mm ~ maschine, data = vergleich)

#t-Wert: −5,1132 (gerundet −5,11)
#Freiheitsgrade: 55,272 (gerundet 55,27)
#p-Wert: 4,092e-06, also 0,000004092 (p < 0,001)
#95-%-Konfidenzintervall der Differenz: [−0,0866; −0,0378]

#3. Der gepaarte Vergleich teil a)

chargen <- daten |>
  group_by(maschine, charge) |>
  summarise(mm = mean(masse_mm, na.rm = TRUE), .groups = "drop") |>
  pivot_wider(names_from = maschine, values_from = mm)


chargen$M3 - chargen$M1

#a) Antwort; Positive Differenzen: 10. Negative: 0. Alle zehn Werte von M3 − M1 sind größer als 0 (von 0,0275 bis 0,1308).

#3. Der gepaarte Vergleich teil b)

t.test(chargen$M3, chargen$M1, paired = TRUE)


#b) Antwort; t-Wert: 5,9822 (≈ 5,98)
#   Freiheitsgrade: 9
#   p-Wert: 0,000207 (p < 0,001)

#c) Antwort;Der gepaarte Test arbeitet nicht mit den einzelnen Messungen, sondern mit den Chargenmitteln. Pro Charge entsteht eine Differenz M3 − M1, also 10 Differenzen, und daraus ergibt sich df = n − 1 = 10 − 1 = 9.


#4. Kapitel-Check (Navarro Kap. 13)

#a) Antwort; Ist σ unbekannt, schätzt man es aus der Stichprobe (s). Der z-Test behandelt s, als wäre es exakt, der t-Test berücksichtigt dessen Unsicherheit durch die t-Verteilung mit breiteren Rändern, besonders bei kleinem n.

#b) Antwort; Nein. p = 0,42 heißt nur, dass H0 nicht verworfen wird, nicht dass sie stimmt. Es kann ein Fehler 2. Art vorliegen: ein echter Unterschied, der wegen kleiner Stichprobe oder großer Streuung nicht entdeckt wurde.

#c) Antwort; Gepaarter t-Test, wenn dieselben Einheiten oder Bedingungen zweimal gemessen werden:

#Zwei Maschinen fertigen dieselben Chargen (wie in Aufgabe 3): Die Werte einer Charge teilen sich Rohmaterial und Tagesbedingungen, daher gehören sie zusammen.
#Dasselbe Werkstück wird vor und nach einer Wärmebehandlung gemessen: Es ist dasselbe Teil, nur der Zustand ändert sich.
#Dieselben Teile werden von zwei Messgeräten oder Prüfern gemessen: Jedes Teil hat seinen eigenen wahren Wert, die beiden Messungen daran sind also direkt verbunden.


#5. Die Frage hinter der Aufgabe

#a) Antwort;Nein. Der p-Wert zeigt nur, dass der Unterschied wahrscheinlich kein Zufall ist, nicht dass er groß ist. 0,024 mm sind winzig gegenüber ± 0,15 mm, eine Prozessänderung würde also Aufwand ohne spürbaren Nutzen bringen.

#b) Antwort;„Signifikant“ heißt: statistisch belegbar, nicht Zufall. „Wirtschaftlich nicht relevant“ heißt: zu klein, um etwas zu bewirken. Stärke des Tests: Er erkennt auch kleine Unterschiede. Grenze: Er sagt nichts über deren Größe oder Bedeutung.

#c) Antwort; Mehr Chargen. Mehr Teile aus denselben Chargen senken nur die Streuung innerhalb der Chargen, die Unterschiede zwischen den Chargen bleiben. Mehr Chargen erfassen genau diese Variation und sind wirksamer.



